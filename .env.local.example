# SHIFTED — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Supabase Dashboard → Project Settings → API).

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The canonical site URL, used to build OAuth / magic-link redirect URLs.
# Local dev: http://localhost:3000
# Production: https://shiftedth.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret — used ONLY by scripts/seed.mjs (Admin API).
# Never expose this to the browser / never prefix it with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
